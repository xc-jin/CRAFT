    {
        "name": "internalToString",
        "category": "method_declaration",
        "class": "MediaTypeHeaderDelegate",
        "signature": "internalToString(MediaType type)",
        "class_signature": "MediaTypeHeaderDelegate.internalToString(MediaType type)",
        "returnType": "void",
        "modifiers": [],
        "parameters": [
            [
                "MediaType",
                "type"
            ]
        ],
        "methodBody": "{\n        StringBuilder buf = new StringBuilder(type.getType().length() + type.getSubtype().length() + 1);\n\n        buf.append(type.getType().toLowerCase()).append('/').append(type.getSubtype().toLowerCase());\n        if (type.getParameters() == null || type.getParameters().size() == 0)\n            return buf.toString();\n        for (String name : type.getParameters().keySet()) {\n            buf.append(';').append(name).append('=');\n            String val = type.getParameters().get(name);\n            if (quoted(val))\n                buf.append('\"').append(val).append('\"');\n            else\n                buf.append(val);\n        }\n        return buf.toString();\n    }",
