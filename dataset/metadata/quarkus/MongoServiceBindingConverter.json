        "name": "convert",
        "category": "method_declaration",
        "class": "MongoServiceBindingConverter",
        "signature": "convert(List<ServiceBinding> serviceBindings)",
        "class_signature": "MongoServiceBindingConverter.convert(List<ServiceBinding> serviceBindings)",
        "returnType": "void",
        "modifiers": [],
        "parameters": [
            [
                "List<ServiceBinding>",
                "serviceBindings"
            ]
        ],
        "methodBody": "{\n        Optional<ServiceBinding> matchingByType = ServiceBinding.singleMatchingByType(BINDING_TYPE, serviceBindings);\n        if (matchingByType.isEmpty()) {\n            return Optional.empty();\n        }\n\n        ServiceBinding binding = matchingByType.get();\n        Map<String, String> properties = new HashMap<>();\n\n        setConnectionString(binding, properties);\n        setUsername(binding, properties);\n        setPassword(binding, properties);\n\n        return Optional.of(new ServiceBindingConfigSource(BINDING_CONFIG_SOURCE_NAME, properties));\n    }",
