    {
        "name": "doSelectInstances",
        "category": "method_declaration",
        "class": "ServiceUtil",
        "signature": "doSelectInstances(ServiceInfo serviceInfo, String cluster, boolean healthyOnly, boolean enableOnly, InstancesFilter filter)",
        "class_signature": "ServiceUtil.doSelectInstances(ServiceInfo serviceInfo, String cluster, boolean healthyOnly, boolean enableOnly, InstancesFilter filter)",
        "returnType": "void",
        "modifiers": [],
