        "name": "selectInstancesWithHealthyProtection",
        "category": "method_declaration",
        "class": "ServiceUtil",
        "signature": "selectInstancesWithHealthyProtection(ServiceInfo serviceInfo, ServiceMetadata serviceMetadata, String cluster, boolean healthyOnly, boolean enableOnly, String subscriberIp)",
        "class_signature": "ServiceUtil.selectInstancesWithHealthyProtection(ServiceInfo serviceInfo, ServiceMetadata serviceMetadata, String cluster, boolean healthyOnly, boolean enableOnly, String subscriberIp)",
        "returnType": "void",
