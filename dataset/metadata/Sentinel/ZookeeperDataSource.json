        "name": "initZookeeperListener",
        "category": "method_declaration",
        "class": "ZookeeperDataSource",
        "signature": "initZookeeperListener(String serverAddr, List<AuthInfo> authInfos)",
        "class_signature": "ZookeeperDataSource.initZookeeperListener(String serverAddr, List<AuthInfo> authInfos)",
        "returnType": "void",
        "modifiers": [],
        "parameters": [
