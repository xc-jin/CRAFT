    {
        "name": "handleUpdatedAppNamespaces",
        "category": "method_declaration",
        "class": "AppNamespaceServiceWithCache",
        "signature": "handleUpdatedAppNamespaces(Iterable<AppNamespace> appNamespaces)",
        "class_signature": "AppNamespaceServiceWithCache.handleUpdatedAppNamespaces(Iterable<AppNamespace> appNamespaces)",
        "returnType": "void",
        "modifiers": [],
        "parameters": [
